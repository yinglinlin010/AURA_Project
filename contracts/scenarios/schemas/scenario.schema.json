{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aura.local/schemas/scenario.schema.json",
  "title": "AURA headless scenario definition",
  "type": "object",
  "required": ["id", "name", "timeline"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1000 },
    "timeline": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "signal"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "signal" },
              "signal": {
                "type": "object",
                "required": ["type", "value"],
                "properties": {
                  "type": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "value": {},
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "displayId", "command"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "command" },
              "displayId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "command": { "$ref": "protocol.schema.json#/definitions/command" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "task"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "task.start" },
              "task": {
                "type": "object",
                "required": ["taskId", "priority"],
                "properties": {
                  "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "priority": { "enum": ["primary", "secondary", "critical"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
