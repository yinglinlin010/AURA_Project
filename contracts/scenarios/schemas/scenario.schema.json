{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aura.local/schemas/scenario.schema.json",
  "title": "AURA headless scenario definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "timeline"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "expected": {
      "type": "object",
      "properties": {
        "initialState": { "$ref": "#/definitions/stateExpectation" },
        "finalState": { "$ref": "#/definitions/stateExpectation" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepId", "status"],
            "properties": {
              "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "status": { "enum": ["RECEIVED", "REJECTED"] },
              "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepId", "outcome"],
            "properties": {
              "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "outcome": { "enum": ["EXECUTE", "ASK", "ROUTE", "DEFER", "REJECT"] },
              "proposalId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
              "consentRequired": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepId"],
            "properties": {
              "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "proposalId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "kind": { "enum": ["SPEAK", "SHOW_INFORMATION", "SHOW_GUIDANCE", "SEARCH_PLACE", "CALCULATE_ROUTE", "ADD_TRIP_STOP", "START_PARKING_GUIDANCE", "HANDOFF_DISPLAY", "SUPPRESS_NOTIFICATION", "CHANGE_CABIN_SETTING", "PREPARE_OFFLINE_CONTEXT", "REQUEST_CONFIRMATION", "WARN"] },
              "targetRole": { "$ref": "protocol.schema.json#/definitions/displayRole" },
              "status": { "enum": ["proposed", "routed", "awaiting_consent", "deferred", "executing", "declined", "rejected", "interrupted", "completed"] }
            },
            "anyOf": [
              { "required": ["proposalId"] },
              { "required": ["proposalAlias"] },
              { "required": ["kind"] }
            ],
            "additionalProperties": false
          }
        },
        "displays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["displayId"],
            "properties": {
              "displayId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "role": { "$ref": "protocol.schema.json#/definitions/displayRole" },
              "stateFields": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/stateFieldExpectation" }
              }
            },
            "anyOf": [
              { "required": ["role"] },
              { "required": ["stateFields"] }
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "enum": ["completedSteps", "commandReceiptCount", "signalReceiptCount", "policyDecisionCount", "journeyStopCount", "voiceTransitionCount", "stateRevision", "durationMs"] },
              "equals": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            },
            "anyOf": [
              { "required": ["equals"] },
              { "required": ["min"] },
              { "required": ["max"] }
            ],
            "additionalProperties": false
          }
        },
        "signalFreshness": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["stepId", "state"], "properties": {
            "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "state": { "enum": ["fresh", "cached", "stale", "unknown"] }
          }, "additionalProperties": false }
        },
        "taskLifecycle": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["stepId", "taskId", "status"], "properties": {
            "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "status": { "enum": ["running", "interrupted", "completed"] },
            "actionCount": { "type": "integer", "minimum": 0 },
            "actionStatuses": { "type": "array", "items": { "enum": ["pending", "running", "paused", "unknown", "succeeded", "failed", "cancelled"] } },
            "completionEventCount": { "type": "integer", "minimum": 0 },
            "revalidationReality": { "const": "simulated" }
          }, "additionalProperties": false }
        },
        "voice": {
          "type": "object",
          "properties": {
            "policyDecisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "outcome"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "outcome": { "enum": ["EXECUTE", "ASK", "ROUTE", "DEFER", "REJECT"] },
                  "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "consentRequired": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "consents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "proposalAlias", "accepted"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "accepted": { "type": "boolean" },
                  "receiptStatus": { "enum": ["RECEIVED", "REJECTED"] }
                },
                "additionalProperties": false
              }
            },
            "journey": {
              "type": "object",
              "required": ["stopCount", "stopProposalAliases"],
              "properties": {
                "stopCount": { "type": "integer", "minimum": 0 },
                "stopProposalAliases": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
                }
              },
              "additionalProperties": false
            },
            "statesAtSteps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "state"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "state": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] }
                },
                "additionalProperties": false
              }
            },
            "requiredTransitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] },
                  "to": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] }
                },
                "additionalProperties": false
              }
            }
          },
          "anyOf": [
            { "required": ["policyDecisions"] },
            { "required": ["consents"] },
            { "required": ["journey"] },
            { "required": ["statesAtSteps"] },
            { "required": ["requiredTransitions"] }
          ],
          "additionalProperties": false
        }
      },
      "anyOf": [
        { "required": ["initialState"] },
        { "required": ["finalState"] },
        { "required": ["commands"] },
        { "required": ["decisions"] },
        { "required": ["actions"] },
        { "required": ["displays"] },
        { "required": ["metrics"] },
        { "required": ["signalFreshness"] },
        { "required": ["taskLifecycle"] },
        { "required": ["voice"] }
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "signal"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "signal"
              },
              "signal": {
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "value": {},
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "freshness": { "enum": ["fresh", "cached", "stale", "unknown"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object", "required": ["id", "atMs", "kind", "taskId", "actionId", "idempotencyKey", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "atMs": { "type": "integer", "minimum": 0 }, "kind": { "const": "task.action" },
              "taskId": { "type": "string", "minLength": 1, "maxLength": 128 }, "actionId": { "type": "string", "minLength": 1, "maxLength": 128 }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
              "status": { "enum": ["pending", "running", "paused", "unknown", "succeeded", "failed", "cancelled"] }, "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 }, "repeatIdempotently": { "type": "boolean" }
            }, "additionalProperties": false
          },
          {
            "type": "object", "required": ["id", "atMs", "kind", "taskId", "revalidation"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "atMs": { "type": "integer", "minimum": 0 }, "kind": { "const": "task.resume" }, "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "revalidation": { "type": "object", "required": ["reality", "sourceLabel", "candidateFresh", "capabilityConfirmed", "authorizationCurrent", "priorActionOutcomeKnown"], "properties": {
                "reality": { "const": "simulated" }, "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 128 }, "candidateFresh": { "type": "boolean" }, "capabilityConfirmed": { "type": "boolean" }, "authorizationCurrent": { "type": "boolean" }, "priorActionOutcomeKnown": { "type": "boolean" }
              }, "additionalProperties": false }
            }, "additionalProperties": false
          },
          {
            "type": "object", "required": ["id", "atMs", "kind", "taskId"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "atMs": { "type": "integer", "minimum": 0 }, "kind": { "const": "task.complete" }, "taskId": { "type": "string", "minLength": 1, "maxLength": 128 }, "repeatIdempotently": { "type": "boolean" } },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "displayId",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "command"
              },
              "displayId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "command": {
                "$ref": "protocol.schema.json#/definitions/command"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "task"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "task.start"
              },
              "task": {
                "type": "object",
                "required": [
                  "taskId",
                  "priority"
                ],
                "properties": {
                  "taskId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "priority": {
                    "enum": [
                      "primary",
                      "secondary",
                      "critical"
                    ]
                  },
                  "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "currentStep": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "conditions": { "type": "array", "minItems": 1, "items": {
                    "type": "object", "required": ["key", "classification", "source"],
                    "properties": {
                      "key": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "classification": { "enum": ["confirmed", "inferred", "unknown"] },
                      "value": { "type": "string", "maxLength": 500 },
                      "source": { "const": "simulated" },
                      "validForMs": { "type": "integer", "minimum": 1 }
                    }, "additionalProperties": false
                  } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "text",
              "requestedByRole"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "intent"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "requestedByRole": {
                "$ref": "protocol.schema.json#/definitions/displayRole"
              },
              "expectedAvailability": {
                "enum": [
                  "cloud",
                  "local",
                  "offline_local",
                  "unavailable"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "proposalId", "cues"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "perception.parking" },
              "proposalId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "cues": {
                "type": "array", "uniqueItems": true, "maxItems": 8,
                "items": { "enum": ["parking_maneuver_active", "repeated_adjustment", "unfamiliar_parking_context", "driver_requested_guidance"] }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.start" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.text" },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.barge_in" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.stop" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "proposalAlias", "displayId", "decision"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.consent" },
              "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "displayId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "decision": { "enum": ["approve", "decline"] }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "definitions": {
    "stateExpectation": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/stateFieldExpectation" }
        }
      },
      "additionalProperties": false
    },
    "stateFieldExpectation": {
      "type": "object",
      "required": ["path", "equals"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "equals": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
