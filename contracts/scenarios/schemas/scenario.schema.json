{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aura.local/schemas/scenario.schema.json",
  "title": "AURA headless scenario definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "timeline"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "expected": {
      "type": "object",
      "required": ["voice"],
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "policyDecisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "outcome"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "outcome": { "enum": ["EXECUTE", "ASK", "ROUTE", "DEFER", "REJECT"] },
                  "reasonCode": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "consentRequired": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "consents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "proposalAlias", "accepted"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "accepted": { "type": "boolean" },
                  "receiptStatus": { "enum": ["RECEIVED", "REJECTED"] }
                },
                "additionalProperties": false
              }
            },
            "journey": {
              "type": "object",
              "required": ["stopCount", "stopProposalAliases"],
              "properties": {
                "stopCount": { "type": "integer", "minimum": 0 },
                "stopProposalAliases": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
                }
              },
              "additionalProperties": false
            },
            "statesAtSteps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["stepId", "state"],
                "properties": {
                  "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                  "state": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] }
                },
                "additionalProperties": false
              }
            },
            "requiredTransitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] },
                  "to": { "enum": ["IDLE", "LISTENING", "TRANSCRIBING", "THINKING", "SPEAKING"] }
                },
                "additionalProperties": false
              }
            }
          },
          "anyOf": [
            { "required": ["policyDecisions"] },
            { "required": ["consents"] },
            { "required": ["journey"] },
            { "required": ["statesAtSteps"] },
            { "required": ["requiredTransitions"] }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "signal"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "signal"
              },
              "signal": {
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "value": {},
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "displayId",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "command"
              },
              "displayId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "command": {
                "$ref": "protocol.schema.json#/definitions/command"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "task"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "task.start"
              },
              "task": {
                "type": "object",
                "required": [
                  "taskId",
                  "priority"
                ],
                "properties": {
                  "taskId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "priority": {
                    "enum": [
                      "primary",
                      "secondary",
                      "critical"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "atMs",
              "kind",
              "text",
              "requestedByRole"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "intent"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "requestedByRole": {
                "$ref": "protocol.schema.json#/definitions/displayRole"
              },
              "expectedAvailability": {
                "enum": [
                  "cloud",
                  "local",
                  "offline_local",
                  "unavailable"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "proposalId", "cues"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "perception.parking" },
              "proposalId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "cues": {
                "type": "array", "uniqueItems": true, "maxItems": 8,
                "items": { "enum": ["parking_maneuver_active", "repeated_adjustment", "unfamiliar_parking_context", "driver_requested_guidance"] }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.start" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.text" },
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.barge_in" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.stop" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "atMs", "kind", "proposalAlias", "displayId", "decision"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "atMs": { "type": "integer", "minimum": 0 },
              "kind": { "const": "voice.consent" },
              "proposalAlias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
              "displayId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "decision": { "enum": ["approve", "decline"] }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
